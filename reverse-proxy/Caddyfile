# Reverse proxy M2 — exposition publique de ToshibaManager (FR-010 à FR-012).
# Caddy gère automatiquement le certificat TLS (Let's Encrypt) pour le
# domaine configuré, redirige HTTP -> HTTPS, et exige une authentification
# HTTP Basic avant de transmettre toute requête à l'application (FR-011).
#
# Variables fournies via .env (voir ToshibaManager 1/ToshibaManager/.env.example) :
#   DOMAIN                  nom de domaine public (ex. toshiba.exemple.fr)
#   BASIC_AUTH_USER         identifiant partagé
#   BASIC_AUTH_PASSWORD_HASH  hash bcrypt du mot de passe (généré avec
#                              `docker run --rm caddy:2-alpine caddy hash-password`)

{$DOMAIN} {
	# Trois chemins, et trois seulement, restent ouverts : ce sont ceux que le
	# poste du client telecharge lui-meme, depuis un script qui tourne chez lui
	# sans session ni identifiants.
	#
	#   /installer/toolkit.zip   le toolkit PowerShell du .bat copieur
	#   /installer/drivers/*     l'archive du pilote retenu
	#   /poste/outils/*          les installeurs OMB (Kudu, agent GLPI, Office...)
	#
	# Les pages reste protegees, /installer comme /poste : ce sont elles qui
	# emettent les mots de passe, et /poste/glpi/creer ecrit dans le parc GLPI.
	# Ouvrir /installer/* en entier, comme c'etait le cas, laissait la page de
	# generation accessible a tout venant.
	@protege not path /installer/toolkit.zip /installer/drivers/* /poste/outils/*

	basic_auth @protege {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_PASSWORD_HASH}
	}

	reverse_proxy app:5000
}
