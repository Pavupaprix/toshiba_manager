# Copier ce fichier vers `.env` et renseigner les vraies valeurs.
# `.env` ne doit JAMAIS être commité (secrets réels) — voir constitution,
# Principe II (Data Safety & Confidentiality).

# Port interne d'écoute de l'application (M1, optionnel — défaut 5000)
PORT=5000

# --- M2 uniquement : exposition publique via le service `proxy` (Caddy) ---

# Nom de domaine public pointant vers cette machine (FR-010)
DOMAIN=toshiba.exemple.fr

# Identifiants HTTP Basic Auth exigés avant tout accès public (FR-011).
# Générer le hash avec :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'votre-mot-de-passe'
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=$2a$14$remplacer-par-le-hash-genere
