# Copier ce fichier vers `.env` et renseigner les vraies valeurs.
# `.env` ne doit JAMAIS être commité (secrets réels) — voir constitution,
# Principe II (Data Safety & Confidentiality).

# Port interne d'écoute de l'application (M1, optionnel — défaut 5000)
PORT=5000

# --- M2 uniquement : exposition publique via le service `proxy` (Caddy) ---

# Nom de domaine public pointant vers cette machine (FR-010)
DOMAIN=toshiba.exemple.fr

# Identifiants HTTP Basic Auth exigés avant tout accès public (FR-011).
# Générer le hash avec :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'votre-mot-de-passe'
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=$2a$14$remplacer-par-le-hash-genere

# URL publique du service, injectee dans le .bat d'installation genere
# par /installer. A renseigner des que l'application est derriere un
# reverse proxy, sinon le poste client tentera une URL en http://.
PUBLIC_BASE_URL=https://scan.potatodomain.win

# Dossier des archives de pilotes dans le conteneur (defaut /app/drivers).
# DRIVERS_DIR=/app/drivers

# Dossier des installeurs specifiques dans le conteneur (defaut /app/outils),
# utilise par la page "Installer un poste".
# OUTILS_DIR=/app/outils

# --- Agent GLPI (section 4 de la page "Installer un poste") ---
# Sans ces quatre variables, la section s'affiche desactivee au lieu d'echouer.
# Le jeton d'application de l'ancien outil interne est compromis (il etait en
# clair dans un .exe qui a circule) : en generer un nouveau dans GLPI.
GLPI_API_URL=https://gestion.omb-informatique.fr:4443/apirest.php/
GLPI_AGENT_SERVER=https://gestion.omb-informatique.fr:4443/
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Mettre a 0 uniquement si le GLPI presente un certificat auto-signe.
# GLPI_TLS_VERIFICATION=1
